# PostParse environment variables (names only; fill in your own values).
#
# Copy to config/.env (git-ignored). Every CLI command, including
# `postparse serve`, loads the first file found of ./config/.env, ./.env and the
# same files below the project root; variables already set in the environment
# win. Set POSTPARSE_NO_DOTENV=1 to skip .env loading entirely. Plain uvicorn
# (`uvicorn postparse.api.main:create_app --factory`) never reads .env files:
# export the variables yourself in that case.
#
# `postparse config env` shows which of these are set (never their values).

# --- Telegram (extract telegram, check telegram); from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: phone number in international format, used for the first login.
TELEGRAM_PHONE=

# --- Instagram (extract instagram, transcription re-fetches)
INSTAGRAM_USERNAME=
# Optional once a valid session file exists in <sessions_dir>.
INSTAGRAM_PASSWORD=

# --- LLM providers / transcription API
# Read for [[llm.providers]] named "openai" or "lm_studio", and by the
# transcription API backend (transcription.api.api_key_env names the variable).
OPENAI_API_KEY=
# Read for [[llm.providers]] named "anthropic".
ANTHROPIC_API_KEY=

# --- REST API authentication ([api.auth] enabled = true)
JWT_SECRET_KEY=

# --- Optional overrides (win over config.toml)
# POSTPARSE_DATA_DIR=
# POSTPARSE_DB_PATH=
# POSTPARSE_SESSIONS_DIR=
# POSTPARSE_DOWNLOADS_DIR=
# POSTPARSE_TMP_DIR=
